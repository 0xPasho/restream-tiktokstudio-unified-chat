{
  "name": "restream-tiktokstudio-unified-chat",
  "version": "0.1.0",
  "description": "One live chat feed for TikTok, Twitch, YouTube and Kick. Stores to SQLite, renders in Next.js, and ships an OBS overlay.",
  "license": "MIT",
  "author": "Pasho",
  "keywords": [
    "tiktok",
    "twitch",
    "youtube",
    "kick",
    "restream",
    "livestream",
    "chat",
    "obs",
    "overlay",
    "nextjs",
    "sqlite"
  ],
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 7637",
    "build": "next build",
    "start": "next start -p 7637",
    "test": "node --test tests/",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "shot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tiktok-live-connector": "^2.4.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
