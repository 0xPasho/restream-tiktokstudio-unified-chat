# Restream chat embed token.
# Get it from https://chat.restream.io — the embed URL looks like
#   https://chat.restream.io/embed?token=YOUR-TOKEN-HERE
# Only the token part is needed. Powers Twitch, YouTube and Kick.
RESTREAM_CHAT_TOKEN=

# Your TikTok handle, without the leading @. No credentials required.
# TikTok only delivers chat while you are actually live.
TIKTOK_USERNAME=

# Optional: where the SQLite file lives. Defaults to ./data/chat.db
# CHAT_DB_PATH=
